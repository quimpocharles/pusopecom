# PostgreSQL (Railway) — see backend/prisma/schema.prisma
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# JWT
JWT_SECRET=your-jwt-secret-key-min-32-chars

# Email Configuration
EMAIL_HOST=your-smtp-host
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password

# Xendit Payment Gateway (primary — ADR-010)
# https://dashboard.xendit.co/settings/developers#api-keys
# Sandbox vs. live is the key prefix (xnd_development_... vs
# xnd_production_...), not a separate URL like Maya below.
XENDIT_SECRET_KEY=xnd_development_your-xendit-secret-key
# From Dashboard > Settings > Webhooks — verifies the x-callback-token
# header on incoming webhooks (middleware/xenditWebhookVerify.js).
XENDIT_WEBHOOK_TOKEN=your-xendit-webhook-verification-token

# Maya Payment Gateway (legacy — kept live only for in-flight orders during
# the Xendit cutover, see ADR-010. Not used for new checkouts.)
# https://developers.maya.ph/reference/sandbox-credentials-and-cards
MAYA_PUBLIC_KEY=your-maya-public-key
MAYA_SECRET_KEY=your-maya-secret-key

# OAuth - Google
# Get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# OAuth - Facebook
# Get from https://developers.facebook.com/apps/
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Replicate (Fit Check / Virtual Try-On) — primary provider whenever
# REPLICATE_API_TOKEN is set; WaveSpeed below is the automatic fallback,
# used only if Replicate isn't configured or a Replicate attempt throws.
# Get your API token from https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your-replicate-api-token

# Model for the Replicate path — must be one of the keys in
# services/replicateService.js's MODELS map: nano-banana, nano-banana-2,
# or nano-banana-2-lite (an unrecognized value silently falls back to
# nano-banana v1, the code-level conservative default — see that file's
# own comment for why nano-banana-2 is the deliberate choice and
# nano-banana-2-lite is disqualified, not just unchosen).
REPLICATE_MODEL=nano-banana-2

# WaveSpeed AI (Fit Check / Virtual Try-On fallback). Sign up at
# https://wavespeed.ai. Leave unset if Replicate alone is sufficient —
# WaveSpeed only fires when Replicate is unconfigured or fails.
WAVESPEED_API_KEY=your-wavespeed-api-key

# Model for the WaveSpeed path — must be one of the keys in
# services/wavespeedService.js's MODELS map: seedream, nano-banana-2, or
# nano-banana-pro (an unrecognized value silently falls back to seedream,
# the bytedance lite model — this has previously happened with a value
# like "seedream-v5.0-pro", which isn't a real key in that map).
# Set to nano-banana-2 to match the Replicate path's validated choice —
# output quality should be consistent regardless of which provider ends
# up serving a given request.
WAVESPEED_MODEL=nano-banana-2

# Server
PORT=5001
NODE_ENV=development

# Order numbers — PS-20260802-8F4X2K. Leave unset for the PS default.
# ORDER_NUMBER_PREFIX=PS

# Admin
# Legacy fallback for the Daily Business Report (5:00 AM Asia/Manila) —
# only used when no ReportRecipient rows exist yet. Manage real recipients
# from Admin > Reports instead; this var can be removed once that's done.
ADMIN_EMAIL=your-admin-email@example.com

# Sentry (error tracking) — leave unset to disable; app runs fine without it
# Create a project at https://sentry.io and use its DSN
SENTRY_DSN=your-sentry-dsn

# Logging
# LOG_LEVEL=info

# Redis (rate limiting persistence; later: caching, job queue) — leave
# unset to disable; app runs fine without it, falls back to in-memory.
# Local dev: brew install redis && brew services start redis
REDIS_URL=redis://localhost:6379
