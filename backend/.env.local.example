# Local-database overrides for `npm run dev:local` / `db:local:*` (README "Local database").
# Loaded with `node --env-file=.env.local` BEFORE dotenv reads .env, and dotenv never overrides a
# key that's already set — so every key here wins, and everything else still comes from .env.
DATABASE_URL=postgresql://YOUR_MAC_USERNAME@localhost:5432/puso_local

# Keep local runs off production Redis and away from real inboxes.
# Blank = disabled (Redis falls back to in-memory; email sending is skipped, same as the test env).
REDIS_URL=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
NODE_ENV=development
