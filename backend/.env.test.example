# Database the test suite runs against — must be a separate database from
# DATABASE_URL in .env. `vitest run` loads this file (see
# vitest.config.js), not .env, so tests never touch dev/prod data.
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<test-database>
NODE_ENV=test

# Tests never send mail. Do not add SMTP credentials here.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
