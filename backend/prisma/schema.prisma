// PusoStore — Prisma schema
//
// Migrated from Mongoose (see docs/decisions/0000-decision-log.md, ADR-007).
// Field-by-field mapping rationale lives in that ADR and in the migration
// plan discussed before this file was written. Two deliberate compatibility
// choices worth knowing before touching this file:
//
// 1. Money fields (price, salePrice, subtotal, shippingFee, total, orderTotal)
//    use Float, not Decimal. Prisma's Decimal type returns a Prisma.Decimal
//    object in JS, not a plain number — every existing arithmetic call site
//    in routes/services expects a plain number, exactly as Mongoose's Number
//    type already provided. Float preserves that without touching business
//    logic. This is a known tradeoff, not an oversight.
//
// 2. Size labels (ProductSize.size, ProductColorSize.size) are plain String,
//    not a Prisma enum. Two of the legal values ("2XL", "3XL", "One Size")
//    are not valid Prisma enum identifiers, and mapping them would change
//    what Prisma Client returns in JS (the identifier name, not the mapped
//    value) — which would silently break every size string the frontend
//    already depends on. Validity is enforced with a CHECK constraint added
//    by raw SQL in the migration, matching Mongoose's enum validator without
//    the JS-shape risk.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — only for fields whose values are already valid identifiers, so the
// Prisma-side name and the stored/returned value are identical.
// ---------------------------------------------------------------------------

enum AuthProvider {
  local
  google
  facebook
}

enum UserRole {
  customer
  admin
}

// Fit Check's daily-allowance tier. "guest" is deliberately absent — a
// guest has no User row at all (identified only by a client-generated
// sessionId, see TryOnLog.sessionId), so its allowance is a config value
// looked up directly, never a value stored on this enum. Per CLAUDE.md,
// Membership is "an extension point, not built" — `premium` is reserved
// here so the quota config/logic has somewhere real to point once it
// exists, but until then every User row is `registered`.
enum SubscriptionTier {
  registered
  premium
}

// profile_complete/email_verified/first_purchase/admin_grant are wired to a
// real trigger as of Phase 2 of the Fit Check engagement plan. birthday,
// referral, and campaign are reserved the same way SubscriptionTier.premium
// is — the enum slot exists so later phases don't need an enum-alter
// migration, but nothing grants them yet (no birthday field on User, no
// referral system, and campaign awaits FitCheckCampaign in Phase 3).
enum BonusFitCheckReason {
  profile_complete
  email_verified
  first_purchase
  birthday
  referral
  admin_grant
  campaign
}

enum ProductCategory {
  jersey
  tshirt
  cap
  shorts
  accessories
  jacket
  sweatshirt
  hoodie
}

enum Sport {
  basketball
  volleyball
  football
  general
}

enum Gender {
  men
  women
  youth
  unisex
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

// One attempt's lifecycle — distinct from PaymentStatus, which is the
// *order's* current payment state (an aggregate view across however many
// Payment attempts it's had). See the schema comment on Payment below for
// why these are two different vocabularies on purpose.
enum PaymentAttemptStatus {
  pending
  succeeded
  failed
  expired
  cancelled
}

// Payment Platform Redesign, Phase 2. Two axes that used to be conflated
// into one: `processing` meant both "just placed, unpaid" and was the only
// value anything moved through before `confirmed` on payment success.
//
//   awaiting_payment -> paid -> processing -> packed -> shipped -> delivered
//                                                                 -> returned
//           -> failed_payment / expired / cancelled
//
// `awaiting_payment` is the new default at order creation; `processing` is
// repurposed to mean fulfillment prep (post-payment) only, never "unpaid."
// `confirmed` is not deleted — Postgres enums don't shrink cleanly and
// nothing requires it — but is superseded: the migration backfills every
// existing `confirmed` row to `paid`, and no code path sets `confirmed`
// again. Refunds are deliberately not a value here — PaymentStatus.refunded
// already exists and can co-occur with any orderStatus (e.g. `delivered`
// then refunded); duplicating that fact onto this enum would just create
// two places that could disagree.
enum OrderStatus {
  awaiting_payment
  paid
  processing
  packed
  shipped
  delivered
  returned
  cancelled
  expired
  failed_payment
  confirmed // legacy — superseded by `paid`, kept only so old rows/reports don't break
}

enum ActivityType {
  view
  search
}

// A discovery/presentation hint only — never a permission or capability
// gate. What makes an Organization "a league" is that other Organizations
// hold OrganizationParticipation edges pointing at it, not this field. See
// docs/DOMAIN_MODEL.md (Athlete: "modeled as its own lightweight
// Organization... rather than creating a second, inconsistent kind of
// seller") and docs/INFORMATION_ARCHITECTURE.md ("A League ... is itself an
// Organization — not a special category above Organization").
enum OrganizationKind {
  institution // school athletics dept, club, federation, barangay league
  league // UAAP, PBA, PVL — an Organization others participate IN
  athlete // an individual's personal brand
}

// Trust & Verification lifecycle per docs/DOMAIN_MODEL.md: Requested ->
// Reviewed -> Granted -> Continuously Monitored -> (Reaffirmed | Flagged |
// Revoked). "Continuously Monitored" is what `granted` means while it holds,
// not a separate value; "Reaffirmed" is `granted` re-entered with a fresh
// verifiedAt, not a distinct one either.
enum VerificationStatus {
  unverified // default — nothing requested yet
  requested
  reviewed
  granted
  flagged
  revoked
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id                   String           @id @default(uuid())
  email                String           @unique
  password             String?
  firstName            String
  lastName             String
  phone                String?
  ageVerified          Boolean          @default(false)
  avatar               String?
  googleId             String?          @unique
  facebookId           String?          @unique
  authProvider         AuthProvider     @default(local)
  emailVerified        Boolean          @default(false)
  verificationToken    String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  failedLoginAttempts  Int              @default(0)
  accountLocked        Boolean          @default(false)
  role                 UserRole         @default(customer)
  subscriptionTier     SubscriptionTier @default(registered)

  addresses             Address[]
  orders                Order[]
  activities            UserActivity[]
  // Trust & Verification decisions stay human (CLAUDE.md) — this is the
  // accountability record of which admin granted/revoked/flagged a given
  // Organization's status. No code path may set Organization.verifiedByUserId
  // without a real admin id; see organizationRepository.recordVerificationDecision.
  verifiedOrganizations Organization[]
  // Reverse side of OrderEvent.actorUser — which admin made a given
  // status/shipping change. Never set for actor=system/webhook/customer
  // events (see OrderEvent below).
  orderEvents           OrderEvent[]
  wishlist              Wishlist[]
  notifications         Notification[]
  tryOnLogs             TryOnLog[]
  following             Follow[]
  bonusFitCheckGrants   BonusFitCheckGrant[]

  // Enterprise Fulfillment Blueprint, Phase 1 — see the schema comment
  // above Shipment for the reasoning. staffProfile is null for every
  // customer-role User; only admin-role Users have one.
  assignedShipments      Shipment[]
  shipmentEvents         ShipmentEvent[]
  passLogs               PassLog[]
  stockAdjustments       StockAdjustment[]
  refundsInitiated       Refund[]
  staffProfile           StaffProfile?
  // Phase 2 — two distinct relations to the same model need explicit
  // names on both sides (Prisma requirement): the customer who filed the
  // return, and the (possibly different) admin who reviewed it.
  returnRequests         ReturnRequest[]   @relation("ReturnRequester")
  returnRequestsReviewed ReturnRequest[]   @relation("ReturnReviewer")

  // Settings IA redesign — "Updated By" attribution.
  siteSettingsUpdates     SiteSettings[]
  staffProfileUpdatesMade StaffProfile[] @relation("StaffProfileUpdatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// Was User.addresses[] — an embedded array where each entry already had its
// own _id and independent isDefault/edit/delete lifecycle. Real identity,
// real table.
model Address {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  country   String  @default("Philippines")
  address   String
  city      String
  province  String
  region    String?
  barangay  String?
  zipCode   String
  isDefault Boolean @default(false)

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Product
// ---------------------------------------------------------------------------

model Product {
  id           String          @id @default(uuid())
  name         String
  slug         String          @unique
  description  String
  price        Float
  salePrice    Float?
  category     ProductCategory
  sport        Sport
  gender       Gender          @default(unisex)
  league       String?
  team         String?
  player       String?
  images       String[]
  featured     Boolean         @default(false)
  tryOnEnabled Boolean         @default(false)
  active       Boolean         @default(true)
  totalStock   Int             @default(0)
  avgRating    Float           @default(0)
  reviewCount  Int             @default(0)
  totalSold    Int             @default(0)
  totalViews   Int             @default(0)

  sizes             ProductSize[]
  colors            ProductColor[]
  orderItems        OrderItem[]
  reviews           Review[]
  tryOnLogs         TryOnLog[]
  activities        UserActivity[]
  campaigns         Campaign[] // campaigns featuring this product (e.g. the AI Try-On section's featuredProduct)
  wishlistedBy      Wishlist[]
  promoCodeProducts PromoCodeProduct[] // PromoCode.scope = PRODUCT targeting

  // Organization-first migration (ADR-001/002, single pilot Organization —
  // see docs/decisions/0000-decision-log.md and the plan this shipped
  // under). Deliberately nullable and additive: every existing product
  // keeps working unchanged off `league`/`team`/`player` above, which stay
  // the only fields any route reads until the full cutover (M3). Only the
  // pilot Organization's products get these backfilled.
  //
  // The relation field is named `teamRef`, not `team` — that name is
  // already the legacy free-text column above. Naming collision is
  // intentional and must stay: `withRelationFallback` (repositories/
  // serialize.js) collapses a relation object and its FK scalar into one
  // field keyed by the relation field's name, so calling it `team` would
  // silently overwrite the live string with the FK id the moment this
  // relation was ever included. Never add `teamRef`/`organization` to any
  // Product `include` this pass — the two new FKs surface as raw id
  // scalars only.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  teamId         String?
  teamRef        Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // Populated by a BEFORE INSERT/UPDATE trigger added via raw SQL in the
  // init migration (Postgres's replacement for Mongo's $text index) — the
  // column itself is Unsupported to Prisma, so it's never written to
  // directly from application code. The GIN index on it, however, IS
  // declared below (@@index([searchVector], type: Gin)) rather than left
  // as raw SQL: a first attempt left it undeclared, and the next
  // `prisma migrate dev` silently generated a DROP INDEX for it, because
  // Prisma's diffing had no way to know the index was intentional. Once
  // declared, this can't happen again — but it's the reason every future
  // schema change here should go through `migrate dev --create-only` and
  // get its SQL read before being applied, not applied blind.
  searchVector Unsupported("tsvector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // New — closes platform-audit finding High #7 (missing indexes on the
  // fields the main product listing filters by). Not present in the
  // Mongoose schema; added now because this migration already touches
  // every Product read/write path.
  @@index([sport, league, team, category, gender, active])
  @@index([totalSold])
  @@index([totalViews])
  @@index([searchVector], type: Gin)
  @@index([organizationId, active])
  @@index([teamId])
  @@map("products")
}

// Was Product.sizes[] (sizeStockSchema, no independent _id in Mongoose, but
// promoted to a real table regardless) because Inventory reservation needs
// row-level locking — see Commerce Engine's Inventory rules and platform
// audit Critical #3 (the stock-overselling race condition).
model ProductSize {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String // XS | S | M | L | XL | 2XL | 3XL | One Size — CHECK constraint added via raw SQL
  stock     Int     @default(0)

  // Enterprise Fulfillment Blueprint, Phase 1
  stockAdjustments StockAdjustment[]
  locations        ProductLocation[]

  @@unique([productId, size])
  @@map("product_sizes")
}

// Was Product.colors[] (colorVariantSchema, had its own _id — independent
// identity, real table).
model ProductColor {
  id        String             @id @default(uuid())
  productId String
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String
  hex       String?
  image     String?
  sizes     ProductColorSize[]

  @@index([productId])
  @@map("product_colors")
}

// Was the nested colorVariantSchema.sizes[] (colorSizeStockSchema) — two
// levels of embedding flatten into two related tables.
model ProductColorSize {
  id      String       @id @default(uuid())
  colorId String
  color   ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
  size    String // same CHECK constraint as ProductSize.size
  stock   Int          @default(0)

  // Enterprise Fulfillment Blueprint, Phase 1
  stockAdjustments StockAdjustment[]
  locations        ProductLocation[]

  @@unique([colorId, size])
  @@map("product_color_sizes")
}

// ---------------------------------------------------------------------------
// Order
// ---------------------------------------------------------------------------

model Order {
  id          String  @id @default(uuid())
  orderNumber String  @unique
  userId      String?
  user        User?   @relation(fields: [userId], references: [id])
  email       String

  items  OrderItem[]
  passes Pass[]

  // Was the single embedded `shippingAddress` object. Flattened to columns
  // (prefixed shipTo*, not shipping*, to avoid colliding with the
  // pre-existing top-level Order.shippingMethod / Order.shippingRegion
  // fields below, which are distinct from the embedded address's own
  // `region` field in the original schema) — always exactly one per order,
  // never independently queried, so a join table would only add overhead.
  //
  // fullName/phone/country stay required — contact info any order needs,
  // Pass or Merchandise (mirrors ticket-sys's own buyerName/buyerPhone,
  // which never had an address concept at all). The genuinely
  // shipping-specific fields are nullable: a Pass is never shipped
  // (ADR-011 addendum — Pass and Merchandise checkouts don't mix), so
  // there's nothing to address.
  shipToFullName String
  shipToPhone    String
  shipToCountry  String  @default("Philippines")
  shipToAddress  String?
  shipToCity     String?
  shipToProvince String?
  shipToRegion   String?
  shipToBarangay String?
  shipToZipCode  String?

  subtotal         Float
  shippingFee      Float         @default(150)
  // Promo Code Discounts — total = subtotal + shippingFee - discountAmount,
  // uniformly for every PromoDiscountType. FREE_SHIPPING sets discountAmount
  // equal to the real computed shippingFee rather than zeroing shippingFee
  // itself, so the real cost stays visible/auditable and one formula covers
  // every code type.
  promoCodeId      String?
  promoCode        PromoCode?    @relation(fields: [promoCodeId], references: [id])
  discountAmount   Float         @default(0)
  // Xendit gateway integration — the processing fee is passed to the
  // customer, not absorbed, and varies by which channel they pick
  // (GCASH/MAYA/CARD/BANK_TRANSFER/QRPH — see lib/payments/xenditFees.js).
  // paymentChannel is chosen in our own checkout UI before redirect, so the
  // exact fee is known and disclosed before total is locked in — never
  // decided on Xendit's own hosted page after the fact.
  paymentChannel   String?
  gatewayFeeAmount Float         @default(0)
  total            Float
  paymentMethod    String        @default("xendit")
  paymentStatus    PaymentStatus @default(pending)
  mayaPaymentId    String?
  mayaCheckoutUrl  String?
  orderStatus      OrderStatus   @default(awaiting_payment)
  courier          String?
  trackingNumber   String?
  shippingMethod   String?
  shippingRegion   String?
  notes            String?

  // Payment Platform Redesign, Phase 6 — which reminder tiers
  // (lib/sendPaymentReminders.js's TIERS: '24h'/'6h'/'2h') have already
  // been emailed for this order's payment deadline. Lives on Order, not
  // Payment: the deadline being reminded about is the order's own
  // retention window (createdAt + SiteSettings.orderRetentionHours — the
  // real "you lose your reserved stock" cliff, Phase 4), not any one
  // checkout session's ephemeral 1-hour Maya expiry. Regenerating a
  // session (Phase 3) creates a new Payment row but must never reset which
  // reminders already went out for this same underlying deadline.
  //
  // Pending-Payment Email UX Revision — also holds sendPaymentReminders.js's
  // checkout-relative INITIAL_TIER_KEY ('initial_30m'), the delayed
  // replacement for the "Complete Your Payment" email that used to send
  // unconditionally at checkout. Same array, same idempotency mechanism;
  // that tier's threshold is just measured from createdAt directly instead
  // of from the retention deadline.
  //
  // Durable Payment Reminder Delivery — a bare entry (e.g. '24h') means
  // that tier was actually delivered (or deliberately, permanently
  // skipped as a stale catch-up — see sendPaymentReminders.js's
  // skipKeys), never merely attempted. A transient in-flight attempt is
  // instead encoded as one extra entry, '<tierKey>:claimed:<epochMs>',
  // written/removed atomically via orderRepository.casReminderTiers — see
  // that function and sendPaymentReminders.js's attemptTier for the full
  // claim/finalize/release protocol this array's contents implement.
  paymentReminderTiers String[] @default([])

  // Set only after the confirmation email's SMTP send resolves. A null value
  // on a paid order means delivery is still owed and the retry sweep may
  // attempt it again.
  confirmationEmailSentAt DateTime?
  // Short-lived lease for one confirmation-email attempt. A stale claim is
  // reclaimable after the retry lease window; SMTP remains at-least-once.
  confirmationEmailClaimedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events OrderEvent[]

  // Payment Platform Redesign, Phase 1 — the detailed, historical payment
  // record now lives here, one row per checkout-session attempt. Order's
  // own paymentMethod/paymentStatus/mayaPaymentId/mayaCheckoutUrl fields
  // above are kept and still written on every payment event (dual-write,
  // deliberate coexistence during transition — see the migration's own
  // comment) so every existing consumer keeps working unchanged; they're
  // the fast "what's the current state" read, Payment is the full history
  // underneath. "Current" payment is just the most recent row for this
  // orderId (paymentRepository.findLatestForOrder), not a second pointer
  // field that could drift out of sync with reality.
  payments Payment[]

  // Enterprise Fulfillment Blueprint, Phase 1 — Order stays the
  // customer-facing "purchase commitment" record, unchanged; these three
  // are where the fulfillment/inventory/money detail this Blueprint adds
  // actually lives. See the schema comment above Shipment.
  shipments        Shipment[]
  stockAdjustments StockAdjustment[]
  refunds          Refund[]
  returnRequests   ReturnRequest[]

  // New — closes platform-audit finding High #7 for Order's admin
  // stats/listing/report queries.
  @@index([paymentStatus, orderStatus, userId, createdAt])
  @@index([paymentStatus, confirmationEmailSentAt, updatedAt])
  @@index([promoCodeId])
  @@map("orders")
}

// ---------------------------------------------------------------------------
// Payment — Payment Platform Redesign, Phase 1. One row per checkout-session
// attempt (not one mutable row per order) — this is what actually delivers
// multi-attempt history/auditing rather than a single row that overwrites
// itself on retry. `status` here is this one attempt's own lifecycle;
// Order.paymentStatus is the order-level aggregate ("has any attempt
// succeeded") — the two are related but not the same field twice.
//
// `expiresAt` is computed and stored by this platform at creation time, not
// read from the gateway: Maya's Checkout API returns no expiration field at
// all, and its session validity is a fixed, undocumented-as-configurable
// 1 hour (verified against developers.maya.ph before this was designed).
// "Never depend solely on Maya for state" starts here, one layer earlier
// than the request itself anticipated.
// ---------------------------------------------------------------------------

model Payment {
  id    String @id @default(uuid())
  order Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  orderId String

  // "maya" today. A plain String, not an enum — matches Order.paymentMethod's
  // existing convention, and means a new gateway (GCash, PayMongo, Xendit)
  // never requires a schema migration just to be nameable here.
  provider String

  status PaymentAttemptStatus @default(pending)

  // Maya's checkoutId — what createCheckoutSession returns and what the
  // webhook/poll path looks status up by.
  checkoutReference        String?
  // Populated once a real payment (not just a checkout session) exists;
  // may differ from checkoutReference depending on gateway. Nullable
  // because most gateways only expose this after resolution, if at all.
  providerPaymentReference String?
  checkoutUrl              String?

  expiresAt DateTime?
  paidAt    DateTime?

  errorCode    String?
  errorMessage String?

  // When a webhook was last processed for this specific attempt — distinct
  // from OrderEvent's webhook_received log entry, which records that one
  // happened; this records whether *this* Payment's own resolution was the
  // one it drove.
  webhookProcessedAt DateTime?

  // Raw gateway response, for debugging only — never a business-logic
  // source. Business decisions always go through the normalized `status`.
  providerMetadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Enterprise Fulfillment Blueprint, Phase 1 — a Refund optionally points
  // back at the specific Payment attempt it's reversing.
  refunds Refund[]

  @@index([orderId, createdAt(sort: Desc)])
  @@index([checkoutReference])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// OrderEvent — the Payment & Order Audit Log. Every transition an Order goes
// through (created, gateway resolution, webhook contact, admin status edits)
// appends a row here rather than only overwriting Order's own columns, so
// "what happened to this order and when" survives independently of the
// order's current state — the record Admin Order Timeline reads from.
//
// Deliberately one table with a `type` discriminator and a free-form
// `message`/`metadata`, not a table per event kind — the audit log's job is
// narrating a sequence of things that happened to one Order, not modeling
// each kind's own business rules (those already live where the transition
// itself happens, e.g. tryResolvePayment's atomic guard).
// ---------------------------------------------------------------------------

enum OrderEventType {
  created
  payment_pending
  payment_succeeded
  payment_failed
  payment_expired
  status_updated
  webhook_received
}

// Who/what caused the event — 'admin' is the only case where actorUserId is
// ever populated, mirroring Organization.verifiedByUserId's own discipline
// that human-attributable actions carry a real user id, not just a label.
enum OrderEventActor {
  system
  webhook
  customer
  admin
}

model OrderEvent {
  id      String          @id @default(uuid())
  orderId String
  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type    OrderEventType
  actor   OrderEventActor

  actorUserId String?
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  message  String
  // Free-form, event-specific detail (e.g. gateway name + raw status for a
  // payment event, or the courier/tracking diff for a status_updated event)
  // — never PII beyond what the parent Order already stores.
  metadata Json?

  createdAt DateTime @default(now())

  // Backs orderEventRepository.findByOrder's timeline query — always
  // fetched for one order, ordered chronologically.
  @@index([orderId, createdAt])
  @@map("order_events")
}

// Was Order.items[] (orderItemSchema). name/price/image are intentionally a
// snapshot taken at order time, not a live reference — preserved exactly as
// Mongoose stored it, so order history keeps showing the price actually
// paid rather than today's price.
model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  price     Float
  quantity  Int
  size      String
  color     String?
  image     String

  // Enterprise Fulfillment Blueprint, Phase 2
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Enterprise Fulfillment Blueprint, Phase 1 — the same move this codebase
// already made once for Payment (ADR-008), applied to fulfillment: Shipment
// is its own entity, one-to-many with Order (today 1:1, since real
// multi-Organization orders are still rare pre-full-migration), carrying
// the granular staff-facing queue state Order.orderStatus was never built
// to hold. Order.orderStatus is deliberately untouched — it stays the
// customer-facing, coarse "where is my order" read every email/notification
// already depends on. This is docs/DOMAIN_MODEL.md's own Shipment concept,
// finally built: "belongs to one Order, or more precisely, to one
// Organization's portion of an Order."
// ---------------------------------------------------------------------------

// Preparing -> Shipped -> In Transit -> Delivered, per DOMAIN_MODEL.md's own
// Shipment lifecycle, expanded into the real operational queues a warehouse
// actually works against. `exception` is a deliberate catch-all (failed
// delivery, damage in transit, address issue) rather than enumerating every
// courier failure mode up front — the same "no abstraction before the
// second real use case" discipline this codebase applies everywhere else.
enum ShipmentStatus {
  awaiting_picking
  picking
  packing
  quality_check
  ready_for_courier
  courier_scheduled
  picked_up
  in_transit
  out_for_delivery
  delivered
  completed
  return_requested
  return_approved
  returned
  refund_pending
  refunded
  cancelled
  exception
}

// Who's actually fulfilling this — a plain enum today (only self_fulfilled
// is ever set), but the field exists from day one so a future Partner-
// fulfilled order (Blueprint §14 — vetted logistics Partners, never an open
// marketplace-seller model per ADR-001) doesn't require a migration.
enum FulfillmentSource {
  self_fulfilled
  organization_fulfilled
  partner_3pl
}

model Shipment {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status ShipmentStatus    @default(awaiting_picking)
  source FulfillmentSource @default(self_fulfilled)

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  // Ownership lives on the work item itself, not a separate assignment
  // table — mirrors how Order.userId already works.
  assignedToUserId String?
  assignedToUser   User?   @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)

  // Phase 3 — a real CourierAccount FK now exists alongside the free-text
  // `courier` field. `courier` stays and is dual-written from
  // courierAccount.displayName on every update (same coexistence pattern
  // as Order.courier's own dual-write from Shipment) — nothing that reads
  // the free-text field (AdminOrderDetail.jsx, OrderConfirmation.jsx)
  // needs to change, and a Shipment created before this migration with no
  // courierAccountId still displays exactly as it always did.
  courierAccountId String?
  courierAccount   CourierAccount? @relation(fields: [courierAccountId], references: [id], onDelete: SetNull)
  courier          String?
  trackingNumber   String?
  labelUrl         String?

  packedAt    DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?

  events ShipmentEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, warehouseId, createdAt])
  @@index([assignedToUserId])
  @@map("shipments")
}

// A smaller, more useful type set than one enum value per ShipmentStatus —
// `status_changed` carries the transition in its own `fromStatus`/`toStatus`
// columns instead of a free-text message, which is the actual fix for the
// Fulfillment Audit's finding that OrderEvent's generic `status_updated`
// can't be queried ("every shipment marked delivered in the last hour")
// without parsing message strings. This event type can.
enum ShipmentEventType {
  created
  status_changed
  assigned
  note_added
}

model ShipmentEvent {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  type  ShipmentEventType
  // Reuses OrderEvent's own actor vocabulary rather than inventing a
  // parallel one — system/webhook/customer/admin already covers every
  // fulfillment-side actor too (webhook = a future courier webhook,
  // Phase 3; customer = a return request initiating the event chain).
  actor OrderEventActor

  actorUserId String?
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  fromStatus ShipmentStatus?
  toStatus   ShipmentStatus?

  message  String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([shipmentId, createdAt])
  @@index([toStatus, createdAt])
  @@map("shipment_events")
}

// ---------------------------------------------------------------------------
// Pass — event admission as a Commerce Item category (ADR-011). "Pass," not
// "Ticket": the Domain Model already used this term for the category's
// Fulfillment shape ("an access grant... a scannable pass"), so it became
// the name for the whole category. Mirrors two patterns already proven
// elsewhere in this schema: Product/ProductSize (a lockable-capacity
// variant needs its own row) and Shipment/ShipmentEvent (atomic
// state-machine + typed event log). Sections are capacity-based, not
// seat-level — the same atomic-CAS pattern as stock reservation
// (decrementStock) applied to PassTier.capacity/sold — see the ADR-011
// addendum for why per-seat selection was scrapped.
// ---------------------------------------------------------------------------

model Venue {
  id              String  @id @default(uuid())
  name            String
  slug            String  @unique
  address         String
  city            String
  capacity        Int? // informational total; real sellable capacity is the sum of its VenueSections
  seatingChartUrl String? // static reference image shown to fans on the event page — no coordinate/overlay logic, purely "roughly where each section is"
  active          Boolean @default(true)

  sections VenueSection[]

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  PassEvent PassEvent[]

  @@map("venues")
}

// A named area within a Venue (e.g. "Lower Box A", "Patron", "General
// Admission") — capacity-based, not seat-level (ADR-011 addendum: per-seat
// selection was scrapped after checking it against a real arena's curved
// bowl, which a flat grid couldn't represent honestly).
model VenueSection {
  id      String @id @default(uuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name    String // e.g. "Lower Box A", "Patron", "GA"

  passTiers PassTier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
  @@map("venue_sections")
}

// The Commerce Item for this category — mirrors Product. Time-boxed by
// design (startsAt/endsAt), which is also literally the Drop pattern
// (time-boxed release + fixed capacity) applied here — no separate Drop
// model needed, since nothing else needs one yet (no abstraction before the
// second real use case).
model PassEvent {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  images      String[]

  // Organization-first anchor (ADR-001) — required, not optional: unlike
  // Product.organizationId (a pilot-migration artifact on a pre-existing
  // table), PassEvent is new code with no legacy rows to be lenient toward.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // Display names only, not a Team relation — a League-sourced event's
  // "teams" (e.g. Pinoyliga's roster) only exist as League.teams flat
  // strings for almost every real league (only the one-off FEU pilot has
  // real Team rows), and nothing downstream (customer pages, checkout,
  // Locker) reads PassEvent's team data today — it's purely descriptive.
  // Institution/Athlete-sourced events still pick from real Team.name
  // values; both cases just land here as plain strings, one shape either
  // way rather than a second storage path per Organization kind.
  teamNames String[]

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  startsAt DateTime
  endsAt   DateTime

  // The on-sale window — distinct from startsAt/endsAt (when the event
  // itself happens). Null on either side means no bound, same convention
  // Campaign/PromoMessage/PromoCode already use for their own schedule
  // windows.
  salesStartAt DateTime?
  salesEndAt   DateTime?

  active Boolean @default(true)

  tiers  PassTier[]
  passes Pass[]

  promoCodePassEvents PromoCodePassEvent[] // PromoCode.scope = EVENT targeting

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, active])
  @@index([venueId])
  @@index([startsAt])
  @@map("pass_events")
}

// The Product-Variant equivalent — mirrors ProductSize. capacity/sold
// counters, decremented atomically exactly like ProductSize.stock — every
// tier is capacity-based now (ADR-011 addendum: per-seat selection was
// scrapped, so there's no longer a second, seat-derived shape to keep in
// sync with this one).
model PassTier {
  id             String       @id @default(uuid())
  passEventId    String
  passEvent      PassEvent    @relation(fields: [passEventId], references: [id], onDelete: Cascade)
  venueSectionId String
  venueSection   VenueSection @relation(fields: [venueSectionId], references: [id])

  name  String // e.g. "GA", "VIP", "Lower Box A"
  price Float // canonical price for this tier — same single-source-of-truth rule as Product.price

  capacity Int?
  sold     Int? @default(0)

  passes Pass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([passEventId])
  @@map("pass_tiers")
}

enum PassStatus {
  issued
  checked_in
  cancelled
  refunded
}

// The individual, scannable admission credential — one row per admitted
// person, not one row per line item. Deliberately not split into an
// OrderItem-equivalent plus a Shipment-equivalent the way Merchandise is: a
// Merchandise OrderItem of quantity 3 ships as one Shipment (one package),
// but three admission Passes need three independently scannable
// credentials — "what was purchased" and "the fulfillment unit" are
// naturally 1:1 here, so one entity serves both roles (ADR-011).
model Pass {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  passEventId String
  passEvent   PassEvent @relation(fields: [passEventId], references: [id])
  passTierId  String
  passTier    PassTier  @relation(fields: [passTierId], references: [id])

  // Snapshot, same reasoning as OrderItem.price — order history keeps
  // showing what was actually paid, not today's tier price.
  price Float

  status    PassStatus @default(issued)
  qrToken   String     @unique @default(uuid())
  // Lazily generated — not set at issuance, since Cloudinary upload is
  // I/O-bound and has no business holding the order-creation transaction
  // open. Populated the first time it's actually needed (the confirmation
  // email), null for any Pass never emailed.
  qrCodeUrl String?

  checkedInAt DateTime?

  logs PassLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([passEventId])
  @@index([qrToken])
  @@map("passes")
}

enum PassLogType {
  created
  status_changed
}

// The ShipmentEvent-equivalent typed audit row for a Pass's own status
// changes — named PassLog, not PassEvent, to avoid colliding with the
// PassEvent model above (the ticketed happening itself).
model PassLog {
  id     String @id @default(uuid())
  passId String
  pass   Pass   @relation(fields: [passId], references: [id], onDelete: Cascade)

  type  PassLogType
  actor OrderEventActor // reused, same as ShipmentEvent — see that model's own comment

  actorUserId String?
  actorUser   User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  fromStatus PassStatus?
  toStatus   PassStatus?

  message  String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([passId, createdAt])
  @@map("pass_logs")
}

// The missing inventory audit trail the Fulfillment Audit flagged directly:
// stock reservation/release today happens silently inside a transaction,
// with no row anywhere saying why a count changed. Every adjustment here
// carries a reason, an optional link back to what caused it, and who did it.
enum StockAdjustmentType {
  damaged
  quarantine
  returned
  correction
  incoming
  outgoing
}

model StockAdjustment {
  id String @id @default(uuid())

  // Exactly one of these two is set, mirroring OrderItem's own
  // size/color-optional convention — a product tracked in "simple" mode
  // adjusts a ProductSize row, a color-variant product adjusts a
  // ProductColorSize row.
  productSizeId      String?
  productSize        ProductSize?      @relation(fields: [productSizeId], references: [id], onDelete: SetNull)
  productColorSizeId String?
  productColorSize   ProductColorSize? @relation(fields: [productColorSizeId], references: [id], onDelete: SetNull)

  type          StockAdjustmentType
  quantityDelta Int // positive = added back to sellable stock, negative = removed
  reason        String?

  relatedOrderId String?
  relatedOrder   Order?  @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)

  staffUserId String?
  staffUser   User?   @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productSizeId, createdAt])
  @@index([productColorSizeId, createdAt])
  @@index([relatedOrderId])
  @@map("stock_adjustments")
}

// The first real writer PaymentStatus.refunded has ever had (Fulfillment
// Audit: the enum value existed since Payment Platform Redesign Phase 1,
// never once written). Phase 1 scope is deliberately minimal — just enough
// to record that a refund is owed and track it to completion; the full
// ReturnRequest/ReturnItem customer-facing flow this normally originates
// from is Phase 2. A cancellation can create a Refund directly without a
// ReturnRequest, since nothing was ever shipped to return.
enum RefundStatus {
  pending
  processing
  succeeded
  failed
}

model Refund {
  id String @id @default(uuid())

  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  // Set when this Refund originated from a Return inspection (routes/
  // returns.js's POST /:id/inspect) rather than a bare Shipment
  // cancellation (routes/shipments.js) — lets the admin Returns queue
  // resolve straight to "the" refund for a given return without parsing
  // Refund.reason as a pseudo-foreign-key.
  returnRequestId String?
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)

  amount Float
  reason String?
  status RefundStatus @default(pending)

  // Populated once a real refund API call exists (paymentService.js's own
  // "Issue Refund" interface comment has named this as intended, unbuilt,
  // since Payment Platform Redesign — Phase 2 is what finally calls it).
  providerRefundReference String?

  initiatedByUserId String?
  initiatedByUser   User?   @relation(fields: [initiatedByUserId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([orderId, createdAt])
  @@index([status])
  @@map("refunds")
}

// ---------------------------------------------------------------------------
// ReturnRequest / ReturnItem — Enterprise Fulfillment Blueprint, Phase 2.
// The customer-submitted intake record (reason, photos, which items) that
// drives a Shipment through its own return_requested -> return_approved ->
// returned -> refund_pending -> refunded states (Phase 1's adjacency map
// already has all five). ReturnRequest.status is the detailed record of
// that same journey — reason, reviewer, resolution notes — that Shipment's
// bare status alone was never meant to carry; see COMMERCE_ENGINE.md's own
// governing rule this implements: "a return is a coordinated reversal...
// Inventory is restocked, or isn't... Payment is refunded... Fulfillment
// status is updated."
// ---------------------------------------------------------------------------

enum ReturnStatus {
  requested
  under_review
  approved
  rejected
  return_shipped
  received
  inspected
  refund_pending
  refunded
  closed
}

// Drives whether a received item's stock goes back to a sellable Bin or a
// quarantine one (Blueprint §7/§8) — never assumed sellable by default.
enum ReturnItemCondition {
  sellable
  damaged
  unsellable
}

model ReturnRequest {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Guest orders have no User row — same optional-userId convention Order
  // itself already uses; ownership for a guest's return is instead proven
  // the same way a guest's order lookup already is (order number + email).
  userId String?
  user   User?   @relation("ReturnRequester", fields: [userId], references: [id], onDelete: SetNull)

  reason      String
  description String?
  photos      String[] @default([])

  status ReturnStatus @default(requested)

  reviewedByUserId String?
  reviewedByUser   User?     @relation("ReturnReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  resolutionNotes  String?

  items   ReturnItem[]
  refunds Refund[]

  requestedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([status, requestedAt])
  @@map("return_requests")
}

model ReturnItem {
  id              String               @id @default(uuid())
  returnRequestId String
  returnRequest   ReturnRequest        @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem            @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity        Int
  condition       ReturnItemCondition?

  @@map("return_items")
}

// ---------------------------------------------------------------------------
// Warehouse / Zone / Bin — deliberately three levels, not four. Shelf and
// Row fold into Bin's own free-text location code (e.g. "A-12-3") rather
// than two more join tables purely for hierarchy's sake — the same
// "no abstraction before the second real use case" discipline this
// codebase applies everywhere else. Every table carries a path back to
// Warehouse from day one so a second warehouse is a data-entry operation
// later, not a migration (the same pattern Payment.provider already proved
// for a second payment gateway that doesn't exist yet either).
// ---------------------------------------------------------------------------

model Warehouse {
  id      String  @id @default(uuid())
  name    String
  code    String  @unique
  address String?
  active  Boolean @default(true)

  zones     WarehouseZone[]
  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("warehouses")
}

// Enterprise Fulfillment Blueprint, Phase 3 — the account-registry half of
// §6's courier abstraction. `courierName` matches a key in
// courierService.js's own GATEWAYS registry ('manual' today, a real
// provider's key once one exists) — the two are meant to be read
// side-by-side, not duplicated vocabulary. `config` is a placeholder for
// real API credentials, unused by the only gateway implemented so far.
model CourierAccount {
  id          String  @id @default(uuid())
  courierName String  @unique
  displayName String
  config      Json?
  active      Boolean @default(true)

  shipments Shipment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("courier_accounts")
}

model WarehouseZone {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  name        String

  bins Bin[]

  @@unique([warehouseId, name])
  @@map("warehouse_zones")
}

model Bin {
  id     String        @id @default(uuid())
  zoneId String
  zone   WarehouseZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  label  String // e.g. "A-12-3" — see the hierarchy comment above

  locations ProductLocation[]

  @@unique([zoneId, label])
  @@map("bins")
}

model ProductLocation {
  id    String @id @default(uuid())
  binId String
  bin   Bin    @relation(fields: [binId], references: [id], onDelete: Cascade)

  // Same exactly-one-of convention as StockAdjustment above.
  productSizeId      String?
  productSize        ProductSize?      @relation(fields: [productSizeId], references: [id], onDelete: Cascade)
  productColorSizeId String?
  productColorSize   ProductColorSize? @relation(fields: [productColorSizeId], references: [id], onDelete: Cascade)

  quantity Int @default(0)

  @@index([productSizeId])
  @@index([productColorSizeId])
  @@map("product_locations")
}

// ---------------------------------------------------------------------------
// StaffProfile — Blueprint §5. Deliberately a separate table from User,
// gated to admin-role Users only, rather than widening User itself with
// mostly-null columns every customer row would carry. Two axes kept
// distinct on purpose: User.role stays the coarse "can this person reach
// /admin at all" gate (unchanged); department + permissions here answer
// "what does this person actually do" — a question nothing in this
// codebase could answer before this (the Fulfillment Audit found the only
// existing permission distinction anywhere was a hardcoded email string
// duplicated in two files).
// ---------------------------------------------------------------------------

enum StaffDepartment {
  warehouse
  support
  finance
  operations
  marketing
  executive
}

model StaffProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  department  StaffDepartment
  title       String?
  // A string array, not a permission-per-department hardcode — the same
  // "string, not enum" flexibility Payment.provider already uses, chosen
  // for the same reason: a new permission shouldn't require a migration.
  permissions String[]        @default([])
  active      Boolean         @default(true)

  // Settings IA redesign — "who last changed someone's department/
  // permissions" is a real security-relevant question, not just cosmetic.
  updatedByUserId String?
  updatedByUser   User?   @relation("StaffProfileUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("staff_profiles")
}

// ---------------------------------------------------------------------------
// Organization — the anchor everything institutional attaches to (ADR-001).
// A League (UAAP, PBA, PVL) and an Athlete are NOT separate entities — each
// is an Organization row, distinguished by `kind` and by which edges point
// at it (OrganizationParticipation, AthleteAffiliation below), per
// docs/DOMAIN_MODEL.md and docs/INFORMATION_ARCHITECTURE.md. This is a
// single-pilot migration: only Far Eastern University and UAAP exist as
// real rows here so far. Every other Organization continues to be
// represented by the flat Product.league/team strings and the pre-existing
// League model until the full cutover (M3) — see the League model below for
// how the two coexist during transition.
// ---------------------------------------------------------------------------

model Organization {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  shortName   String? // e.g. "FEU" — real values sourced from scripts/uaapImport
  kind        OrganizationKind @default(institution)
  description String?
  logoUrl     String?
  active      Boolean          @default(true)

  // Trust & Verification. Default `unverified`; no seed, script, or backfill
  // in this migration may write `granted`/`revoked`/`flagged` — enforced in
  // organizationRepository.recordVerificationDecision, not left to
  // discipline (CLAUDE.md: "Trust & Verification grant/revoke decisions
  // stay human"). No admin UI surfaces this yet — Phase 2.
  verificationStatus      VerificationStatus @default(unverified)
  verificationRequestedAt DateTime?
  verifiedAt              DateTime?
  verifiedByUserId        String?
  verifiedBy              User?              @relation(fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  verificationNote        String?

  teams      Team[]
  products   Product[]
  passEvents PassEvent[]
  league     League? // the bridge back to the legacy League row, when kind = league

  // Participation is a second relationship kind, distinct from the
  // ownership Organization already has over Team below — a school
  // participates in a league, it isn't owned by it (INFORMATION_ARCHITECTURE.md).
  // Two named relations because this Organization can appear on either side
  // of the edge (FEU is a member; UAAP is the body members participate in).
  participations OrganizationParticipation[] @relation("ParticipationMember")
  participants   OrganizationParticipation[] @relation("ParticipationBody")

  // Same two-sided shape for Athlete affiliation: this Organization can be
  // the athlete, or the team-owning Organization the athlete is affiliated
  // with.
  affiliations AthleteAffiliation[] @relation("AffiliationAthlete")
  affiliates   AthleteAffiliation[] @relation("AffiliationOrganization")

  followedBy                 Follow[]
  fitCheckCampaignsSponsored FitCheckCampaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, active])
  @@map("organizations")
}

// Was League.teams[] (a flat, unowned string array — ADR-002 calls this out
// directly as a content gap: "no ownership, branding, or independent
// identity"). A Team is sport-scoped even where its parent Organization
// spans multiple sports (ADR-002) — FEU the Organization fields both a
// basketball and a volleyball Team.
model Team {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String // unique per Organization, not globally — two Organizations may each field e.g. "mens-basketball"
  sport          Sport
  primaryColor   String?
  secondaryColor String?
  logoUrl        String?
  active         Boolean      @default(true)

  products Product[]

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  AthleteAffiliation AthleteAffiliation[]

  @@unique([organizationId, slug])
  @@index([organizationId, sport])
  @@map("teams")
}

// The *participation* relationship: a member Organization (e.g. FEU)
// participates in a body Organization (e.g. UAAP). Deliberately a separate
// join table, never a reused parent FK on Organization — a reused FK would
// recreate exactly the rigid Sport -> League -> Team tree ADR-001 rejected
// ("national teams don't sit under a 'league' the way a PBA club does").
//
// Unique on (member, in) rather than a partial-unique-where-endDate-is-null
// index, which Prisma 5 can't express declaratively — an undeclared raw
// index is exactly what got silently dropped by an unreviewed `migrate dev`
// once already in this project (see the Product.searchVector comment
// above). Trades "a school that leaves and rejoins a league can't be
// represented as two rows" (zero real instances today) for immunity to
// that failure mode. Revisit at the full cutover.
model OrganizationParticipation {
  id                   String       @id @default(uuid())
  memberOrganizationId String
  memberOrganization   Organization @relation("ParticipationMember", fields: [memberOrganizationId], references: [id], onDelete: Cascade)
  inOrganizationId     String
  inOrganization       Organization @relation("ParticipationBody", fields: [inOrganizationId], references: [id], onDelete: Cascade)
  startDate            DateTime? // nullable — real join dates are unknown; never fabricated
  endDate              DateTime? // null == currently participating

  createdAt DateTime @default(now())

  @@unique([memberOrganizationId, inOrganizationId])
  @@index([inOrganizationId])
  @@map("organization_participations")
}

// Time-bounded, because an athlete's affiliation to a Team-owning
// Organization can end independently of the athlete's own Organization
// staying active — a transfer, a retirement, a new call-up
// (docs/DOMAIN_MODEL.md). Scoped exactly like Product: always to an
// Organization, optionally narrowed to one Team within it — the same
// scoping pattern used everywhere else in this schema. Zero rows exist
// yet; no athlete data exists in production today. Proven by tests only.
model AthleteAffiliation {
  id                    String       @id @default(uuid())
  athleteOrganizationId String
  athleteOrganization   Organization @relation("AffiliationAthlete", fields: [athleteOrganizationId], references: [id], onDelete: Cascade)
  organizationId        String
  organization          Organization @relation("AffiliationOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  teamId                String?
  team                  Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  startDate             DateTime     @default(now())
  endDate               DateTime?

  createdAt DateTime @default(now())

  @@unique([athleteOrganizationId, organizationId, teamId, startDate])
  @@index([organizationId])
  @@index([teamId])
  @@map("athlete_affiliations")
}

// ---------------------------------------------------------------------------
// League
// ---------------------------------------------------------------------------

model League {
  id     String   @id @default(uuid())
  name   String   @unique
  sports Sport[]
  teams  String[]
  active Boolean  @default(true)

  // Bridge to the new Organization model, added by the same single-pilot
  // migration that added Organization itself. Nullable and unique: a
  // League row without this set hasn't been migrated yet, so "has this
  // league been migrated?" is a queryable fact (`WHERE "organizationId" IS
  // NOT NULL`) rather than fuzzy name-matching against Organization.name
  // later. `teams[]` above is superseded, not deleted, by real Team rows —
  // old and new coexist until the full cutover (M3).
  organizationId String?       @unique
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leagues")
}

// ---------------------------------------------------------------------------
// Review
// ---------------------------------------------------------------------------

model Review {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    String
  email     String?
  rating    Int
  title     String?
  body      String?
  verified  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Postgres allows multiple NULLs under a unique constraint by default,
  // which already matches Mongoose's `sparse: true` behavior here — no
  // partial index needed to replicate "one review per email per product,
  // but reviews without an email don't collide."
  @@unique([productId, email])
  @@index([productId])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// ShippingEvent — analytics log, not a business record
// ---------------------------------------------------------------------------

model ShippingEvent {
  id             String   @id @default(uuid())
  // Deliberately a plain string, not a foreign key — matches the existing
  // Mongoose schema exactly (orderId: String, no ref). Tightening this to a
  // real FK now would be inventing a new constraint the original model
  // never had; left as a documented, intentional loose coupling.
  orderId        String
  shippingMethod String
  orderTotal     Float
  region         String?
  createdAt      DateTime @default(now())

  @@map("shipping_events")
}

// ---------------------------------------------------------------------------
// SiteSettings — singleton, same soft convention as the Mongoose model
// (application code finds-or-creates the first row; no DB-level singleton
// constraint existed before, so none is added now).
// ---------------------------------------------------------------------------

model SiteSettings {
  id String @id @default(uuid())

  // The homepage Fit Check teaser's title/image/product-link fields
  // (tryOnTitle/tryOnImage/tryOnProductUrl) were removed here — confirmed
  // dead during the Settings IA redesign: Home.jsx renders that section
  // from Campaign(placement='tryOn') exclusively, and settingsService's
  // `tryOn` group had no reader anywhere outside the admin form that wrote
  // it. tryOnAd* below is a separate, genuinely live feature (the Fit
  // Check generation loading-screen ad) and stays.
  tryOnAdVideoUrl   String @default("")
  tryOnAdButtonText String @default("Visit Playtime.ph")
  tryOnAdButtonUrl  String @default("https://www.playtime.ph/")

  // Fit Check daily allowances — "no values should be hardcoded" per the
  // Fit Check engagement-platform plan. Read by lib/fitCheckQuota.js on
  // every quota check; changing these here takes effect immediately, no
  // deploy required. Defaults match the plan's own worked example
  // (guest 1 / registered 5 / premium 10).
  fitCheckDailyLimitGuest      Int @default(1)
  fitCheckDailyLimitRegistered Int @default(5)
  fitCheckDailyLimitPremium    Int @default(10)
  // How long a guest's Fit Check stays in temporary storage before
  // automatic cleanup if they never register — see the guest migration
  // job. Not the same clock as the registered-gallery 90-day TryOnLog
  // cleanup cron; guests get a much shorter, deliberately short-lived window.
  fitCheckGuestRetentionHours  Int @default(24)

  // Bonus Fit Checks (Phase 2) — a global kill switch plus one amount per
  // reason that actually has a live trigger (see BonusFitCheckGrant).
  // birthday/referral/campaign have no config knob yet because nothing
  // grants them yet — adding a number nobody reads would violate "no
  // abstraction before the second real use case."
  fitCheckBonusEnabled         Boolean @default(true)
  fitCheckBonusProfileComplete Int     @default(1)
  fitCheckBonusEmailVerified   Int     @default(1)
  fitCheckBonusFirstPurchase   Int     @default(2)

  // Trending Fit Checks (Phase 4) — how far back tryOnLogRepository.trending()
  // looks, and how many products the homepage module shows.
  fitCheckTrendingWindowDays Int @default(7)
  fitCheckTrendingLimit      Int @default(8)

  // Payment Platform Redesign, Phase 4 — how long a still-unpaid order
  // stays recoverable before lib/expireStaleOrders.js's hourly sweep
  // marks it Expired and releases its reserved stock. A real kill switch,
  // not just a config number nobody can turn off if something looks wrong.
  orderExpirationEnabled Boolean @default(true)
  orderRetentionHours    Int     @default(48)

  // ePayGames evaluation (see docs/decisions/0000-decision-log.md) — which
  // paymentService.js GATEWAYS entry new orders are created against.
  // Admin-editable so the operational gateway can change without a deploy;
  // defaults to 'xendit' to preserve today's hardcoded behavior exactly
  // when this has never been set. A plain string, not an enum, matching
  // Payment.provider/Order.paymentMethod's existing "never needs a schema
  // migration just to add a gateway name" convention.
  defaultPaymentGateway String @default("xendit")

  // Settings IA redesign — "Last Updated / Updated By" on every category
  // page. updatedAt already existed; this is the first real writer of who.
  updatedByUserId String?
  updatedByUser   User?   @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ---------------------------------------------------------------------------
// Bonus Fit Checks — Phase 2 of the Fit Check engagement plan. An auditable
// grant ledger, not just a bigger daily number: "amount" is how many this
// grant is worth, "consumedCount" tracks how many of those have been drawn
// down. Balance = amount - consumedCount, summed across every grant a user
// has. Consumed only after today's free daily allowance runs out (see
// lib/fitCheckQuota.js) — a durable top-up, not a second daily counter.
// Guests never appear here: every reason requires a real account.
// ---------------------------------------------------------------------------
model BonusFitCheckGrant {
  id            String              @id @default(uuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason        BonusFitCheckReason
  amount        Int
  consumedCount Int                 @default(0)
  // Free-text context for admin_grant (why a human decided to grant this) —
  // null for every event-triggered reason, which is self-explanatory from
  // `reason` alone.
  note          String?
  grantedAt     DateTime            @default(now())

  @@index([userId])
  @@map("bonus_fit_check_grants")
}

// ---------------------------------------------------------------------------
// Homepage Configuration & Content
//
// Production Readiness Audit (2026-08-02) found the homepage's content and
// section layout entirely hardcoded in Home.jsx, with no configuration model
// behind it at all — this is the foundation that closes that gap. Milestone 1
// only: schema, repositories, and API routes. Nothing in Home.jsx reads from
// any of this yet (that's Milestones 3-5); these models exist so the admin
// and frontend work in later milestones has real data to build against.
// ---------------------------------------------------------------------------

// The fixed, known set of reorderable/toggleable sections in the homepage's
// own body — deliberately excludes the Announcement Bar, which is global
// Layout chrome rendered on every page, not a Home.jsx section, and so isn't
// something "homepage section order" can meaningfully include. Its content
// (not its position) is still configurable, via PromoMessage below.
enum HomepageSectionKey {
  hero
  aiTryOn // renamed from shopBySport — the AI Try-On split section replaced it in-place, same slot
  marquee
  featuredProducts
  featuredTeam
  partners
  faq
  trendingFitChecks // Phase 4 of the Fit Check engagement plan
}

// One row per HomepageSectionKey, self-healing (see homepageSectionRepository
// .list()) rather than requiring a manual seed migration — a key with no row
// yet just means nobody has changed the display order or visibility Home.jsx
// already implicitly used before this model existed.
model HomepageSection {
  id           String             @id @default(uuid())
  key          HomepageSectionKey @unique
  displayOrder Int
  active       Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("homepage_sections")
}

// The Hero's content (DOMAIN_MODEL.md's Campaign: "ties a Story, Media, a
// Collection or Drop, and often a Promotion together around a specific
// real-world moment"). Platform-level only for now — no Organization link.
// Milestone 4 (Featured Organization) extends Organization/Team directly per
// its own brief rather than routing through Campaign, so adding an
// organizationId here now would be exactly the speculative coupling
// CLAUDE.md's "no abstraction before the second real use case" warns against.
// `name` is the internal/admin label for telling campaigns apart in a list;
// `headline` etc. are the actual public-facing copy — the two are allowed to
// differ (an admin might name it "Aug 2026 Restock" for a headline that
// actually reads "Game Day Ready").
//
// `placement` was added once a second surface (the homepage's AI Try-On
// section) needed the exact same shape — rotating headline/copy/CTA/
// schedule — for a slot independent of the Hero's own campaign. Mirrors
// PromoMessage.placement below exactly: one model, a discriminator, instead
// of a near-duplicate table per homepage slot.
enum CampaignPlacement {
  hero
  tryOn
}

model Campaign {
  id          String            @id @default(uuid())
  placement   CampaignPlacement @default(hero)
  name        String
  eyebrow     String?
  headline    String
  subheadline String?
  description String?
  image       String?
  ctaLabel    String?
  ctaLink     String?
  accentColor String?

  // Before/after pair for the AI Try-On section's comparison slider.
  // Unused by placement=hero; kept on the shared model rather than a
  // separate table for the same reason `placement` exists at all — one
  // schema, discriminated by slot, not one table per slot.
  beforeImage String?
  afterImage  String?

  // The Product the Try-On CTA should open Virtual Try-On for. Nullable —
  // a hero campaign has no reason to set it, and even a tryOn campaign can
  // leave it unset if ctaLink is set explicitly instead. onDelete: SetNull
  // matches Product.teamId's precedent: a deleted product must never take
  // a still-scheduled campaign down with it.
  featuredProductId String?
  featuredProduct   Product? @relation(fields: [featuredProductId], references: [id], onDelete: SetNull)

  featuredOnHomepage Boolean   @default(false)
  startDate          DateTime?
  endDate            DateTime?
  active             Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Backs campaignRepository.findActiveHomepageCampaign()'s primary filter;
  // the startDate/endDate bounds are checked in application code rather than
  // indexed directly — a handful of campaign rows never justifies a partial
  // or range index, and Prisma 5 can't express one declaratively anyway (see
  // the OrganizationParticipation model's own comment on that same limit).
  @@index([placement, featuredOnHomepage, active])
  @@map("campaigns")
}

// ---------------------------------------------------------------------------
// FitCheckCampaign — Phase 3 of the Fit Check engagement plan. A distinct
// model from Campaign above, on purpose: Campaign is one-active-row-per-
// homepage-slot; this is many-simultaneously-active, targeted at
// products/a category rather than a homepage slot, and drives a real
// commerce mechanic (bypassing the daily Fit Check quota) rather than
// homepage content. Overloading Campaign with unrelated fields would
// violate CLAUDE.md's "vocabulary matches the domain, exactly."
//
// Targeting is a union, not an intersection: a product is covered if it's
// in `productIds` OR its category matches `category`. No Collection
// targeting — Collection is a documented Domain Model concept but isn't a
// real Prisma model yet (CLAUDE.md: Commerce Item extension points build
// out as needed, not ahead of time); add it here once it exists rather
// than pointing at something that doesn't.
//
// `unlimitedFitChecks` is the only override mechanic Phase 3 wires up — the
// plan's own Quota Architecture section describes exactly one check
// ("is the product covered by an active, unlimited campaign? -> bypass
// entirely"), not a second parallel bonus-grant path. Keeping the model to
// what's actually wired rather than a field nobody reads.
model FitCheckCampaign {
  id             String        @id @default(uuid())
  name           String
  sponsorName    String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  productIds String[] // scalar array, same convention as Product.images — a marketing config list, not a relation needing referential integrity
  category   ProductCategory?

  unlimitedFitChecks Boolean @default(true)

  bannerImage    String?
  headline       String
  description    String?
  ctaLabel       String?
  ctaLink        String?
  landingPageUrl String?

  startDate DateTime?
  endDate   DateTime?
  priority  Int       @default(0)
  active    Boolean   @default(true)

  // Phase 4 — a plain incrementing counter, not an event log. Enough for
  // the admin analytics panel's "Views" figure; a per-view row table would
  // be the right call if this ever needed unique-viewer counting, but
  // nothing today asks for that.
  views Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tryOnLogs TryOnLog[] // which Fit Checks this campaign covered — see TryOnLog.fitCheckCampaignId

  @@index([active, priority])
  @@map("fit_check_campaigns")
}

// ---------------------------------------------------------------------------
// FeaturedTeam — the homepage's rotating "Featured Team" spotlight. Was a
// hardcoded object literal in Home.jsx ("swapped by hand once a month");
// this replaces it so it's admin-editable. Same active + schedule-window
// pattern as Campaign (findActive picks the single current one), rather
// than a HomepageSection-style always-all-visible list — only one
// Featured Team is ever shown at a time.
// ---------------------------------------------------------------------------

model FeaturedTeam {
  id          String  @id @default(uuid())
  team        String // the institution's name — also used for the ?team= shop-link filter
  headline    String? // optional H2 override; falls back to `team` when blank
  description String?

  // No separate background-image slot: the current design only ever uses a
  // solid background color (plus CSS-only texture overlays) behind the
  // photo, and adding a background-image treatment would be a new visual
  // feature, not wiring up an existing one — out of scope for this pass.
  backgroundColor String? // hex; institution's own identity color
  textColor       String? // hex; defaults to white in the frontend when unset

  featuredImage    String?
  featuredImageAlt String?

  ctaLabel String? // defaults to "Shop {team} Gear" when blank
  ctaUrl   String? // defaults to /products?team={team} when blank

  displayMonth String? // admin-typed label (e.g. "August 2026"); defaults to the current month when blank
  displayOrder Int     @default(0)
  active       Boolean @default(true)

  // Same nullable-both-sides schedule window as Campaign/PromoMessage.
  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, startDate, endDate])
  @@map("featured_teams")
}

// ---------------------------------------------------------------------------
// PartnerLogo — the homepage's "Our Partners" scrolling strip. Was a
// hardcoded array of bundled image imports in Home.jsx; this replaces it.
// Unlike FeaturedTeam/Campaign, every active logo shows at once (it's a
// list section like FAQ, not a single-winner section) — visibility is a
// plain active flag, no schedule window, since a partner logo isn't a
// time-boxed promotional moment.
// ---------------------------------------------------------------------------

model PartnerLogo {
  id             String  @id @default(uuid())
  name           String // internal/display name, e.g. "Gilas Pilipinas"
  organization   String?
  league         String?
  logoUrl        String
  destinationUrl String?

  // Priority groups logos into the marquee's two rows (higher priority ==
  // row 1); displayOrder sorts within whichever row a logo lands in. Two
  // separate fields because they answer different questions — "how
  // prominent" vs "what order" — matching the spec's own field list.
  priority     Int     @default(0)
  displayOrder Int     @default(0)
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, priority, displayOrder])
  @@map("partner_logos")
}

// ---------------------------------------------------------------------------
// NavigationLink — the site header's nav bar. Was a hardcoded array in
// Header.jsx. `parentId` is a dropdown-ready self-relation — nothing
// renders a dropdown yet (that's a real new frontend feature, out of scope
// for "wire the existing CMS"), but the shape doesn't need a redesign to
// support one later; today's frontend only ever queries top-level
// (parentId = null) links.
// ---------------------------------------------------------------------------

model NavigationLink {
  id           String  @id @default(uuid())
  label        String
  destination  String
  displayOrder Int     @default(0)
  active       Boolean @default(true)
  openInNewTab Boolean @default(false)
  highlight    Boolean @default(false)

  parentId String?
  parent   NavigationLink?  @relation("NavigationDropdown", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationLink[] @relation("NavigationDropdown")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, displayOrder])
  @@index([parentId])
  @@map("navigation_links")
}

// ---------------------------------------------------------------------------
// Footer — was entirely hardcoded JSX in Footer.jsx. Four models rather
// than one: company description/copyright is a singleton (same
// find-or-create convention as SiteSettings), while link groups, social
// links, and payment icons are each independent lists an admin adds to
// freely — forcing them into one shape would either lose the group-label
// distinction footer links need or invent structure the others don't.
// ---------------------------------------------------------------------------

model FooterSettings {
  id String @id @default(uuid())

  companyDescription String?
  // Frontend always prepends "© {currentYear} " — this is just the name/
  // rights-reserved text, so nobody has to remember to bump the year by hand.
  copyrightText      String?

  updatedAt DateTime @updatedAt

  @@map("footer_settings")
}

model FooterLink {
  id           String  @id @default(uuid())
  groupLabel   String // e.g. "Shop", "Legal" — which footer column this link sits in
  label        String
  destination  String
  displayOrder Int     @default(0)
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, groupLabel, displayOrder])
  @@map("footer_links")
}

model SocialLink {
  id           String  @id @default(uuid())
  platform     String // e.g. "facebook", "instagram" — the frontend maps this to a hardcoded icon shape (icons are explicitly exempt from the CMS-everything rule)
  url          String
  displayOrder Int     @default(0)
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, displayOrder])
  @@map("social_links")
}

model PaymentIcon {
  id           String  @id @default(uuid())
  label        String // e.g. "Maya", "GCash", "Visa"
  iconUrl      String? // optional Cloudinary image; falls back to a text label when unset, matching the current text-only design
  displayOrder Int     @default(0)
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, displayOrder])
  @@map("payment_icons")
}

model FAQItem {
  id           String  @id @default(uuid())
  question     String
  answer       String
  displayOrder Int     @default(0)
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, displayOrder])
  @@map("faq_items")
}

// Announcement Bar and Marquee Bar are two different components today with
// two visually different jobs, but identical content shape — a short,
// orderable, togglable line of promotional text. One model, one placement
// field, rather than an AnnouncementMessage table and a near-identical
// MarqueeMessage table beside it.
enum PromoPlacement {
  announcement
  marquee
}

model PromoMessage {
  id           String         @id @default(uuid())
  placement    PromoPlacement
  text         String
  link         String?
  displayOrder Int            @default(0)
  active       Boolean        @default(true)

  // Pinned messages sort first within their placement, ahead of
  // displayOrder — the "always show this one first" case a flash-sale or
  // outage notice needs, distinct from just reordering the whole list.
  pinned Boolean @default(false)

  // Same nullable-both-sides schedule window as Campaign
  // (startDate/endDate null = no bound on that side) — findActiveByPlacement
  // applies it the same way campaignRepository.findActiveHomepageCampaign
  // does, so an expired message stops showing with no code change needed.
  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, active, displayOrder])
  @@map("promo_messages")
}

// ---------------------------------------------------------------------------
// PromoCode — a fan-typed code applied at checkout that reduces what they
// pay. Distinct from PromoMessage above despite the similar name: PromoMessage
// is marketing copy (Announcement/Marquee bar text), PromoCode is a real
// Commerce Engine discount mechanism that mutates Order.total. Platform-wide
// only (no per-Organization ownership) — see Decision Log / CLAUDE.md
// Commerce Engine section for the Promotion/Discount vocabulary this
// implements.
// ---------------------------------------------------------------------------

enum PromoDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum PromoScope {
  ORDER
  PRODUCT
  // Targets an entire PassEvent (not a specific PassTier) — the same
  // whole-commerce-item granularity PRODUCT already uses (a whole Product,
  // never a specific ProductColorSize variant). See PromoCodePassEvent.
  EVENT
}

model PromoCode {
  id          String  @id @default(uuid())
  code        String  @unique // stored uppercased/trimmed by the repository
  description String? // internal admin note only, never shown to customers

  discountType PromoDiscountType
  // App-level rule, not a DB constraint (same convention as PromoMessage's
  // schedule window below): FREE_SHIPPING always implies scope = ORDER.
  scope        PromoScope        @default(ORDER)
  percentOff   Float? // 1-100, required when discountType = PERCENTAGE
  amountOff    Float? // pesos, required when discountType = FIXED_AMOUNT

  startsAt DateTime?
  endsAt   DateTime?

  maxRedemptions   Int?
  redemptionCount  Int    @default(0)
  perCustomerLimit Int?
  minOrderValue    Float?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products   PromoCodeProduct[]
  passEvents PromoCodePassEvent[]
  orders     Order[]

  @@map("promo_codes")
}

// Only populated when PromoCode.scope = PRODUCT — the set of Commerce Items
// a "percent/fixed off specific items" code discounts.
model PromoCodeProduct {
  id          String    @id @default(uuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, productId])
  @@index([productId])
  @@map("promo_code_products")
}

// Only populated when PromoCode.scope = EVENT — the set of PassEvents a
// "percent/fixed off this event's Passes" code discounts. Deliberately
// targets the whole PassEvent, not a specific PassTier — same granularity
// PromoCodeProduct already uses for Product (never a specific
// ProductColorSize variant). See the ADR/audit note on PromoScope.EVENT.
model PromoCodePassEvent {
  id          String    @id @default(uuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  passEventId String
  passEvent   PassEvent @relation(fields: [passEventId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, passEventId])
  @@index([passEventId])
  @@map("promo_code_pass_events")
}

// ---------------------------------------------------------------------------
// ReportRecipient — who the Daily Business Report (and future scheduled
// reports) get emailed to. Replaces the single ADMIN_EMAIL env var the
// original daily sales job used. Deliberately no role/permission scoping —
// the Reporting module's RBAC (Finance/Operations/Marketing/etc.) was
// explicitly deferred; every active recipient gets the same report today.
// Revisit this table, not a new one, when that's built — the shape (email +
// active flag) is the same one a role column would extend, not replace.
// ---------------------------------------------------------------------------

model ReportRecipient {
  id     String  @id @default(uuid())
  email  String  @unique
  active Boolean @default(true)

  createdAt DateTime @default(now())

  @@map("report_recipients")
}

// ---------------------------------------------------------------------------
// ReportRun — the Report Archive. Every time a scheduled report generates
// (currently only the Daily Business Report), this records what happened,
// independent of the ReportRecipient list, which can change later. `data`
// is a frozen snapshot in the exact shape
// dailyBusinessReportService.generateDailyBusinessReport() returns —
// Download regenerates a CSV/XLSX file from this saved snapshot rather than
// storing a binary blob, so "what got sent on that day" never drifts from
// what the DB looks like now. `type` is a real enum with one member today
// on purpose — the Reporting module names other future report types
// (Weekly/Monthly/Quarterly business reports, per spec) that reuse this
// same table rather than getting their own, so the enum is the extension
// point, not a new model per report type.
// ---------------------------------------------------------------------------

enum ReportRunType {
  daily_business_report
  weekly_business_report
  monthly_business_report
  quarterly_business_report

  // Reports Module Redesign, Phase 3 — the 5 AM daily slot's single email
  // split into six, one per report workspace, each archived under its own
  // type so it's independently downloadable in Exports > Archive. All six
  // still share the one existing daily ReportSchedule on/off toggle.
  executive_daily_report
  sales_report
  inventory_report
  fulfillment_report
  fit_check_analytics_report
  organization_performance_report
}

enum ReportRunStatus {
  sent
  failed
  skipped // no active recipients configured — nothing was generated or sent
}

model ReportRun {
  id     String          @id @default(uuid())
  type   ReportRunType   @default(daily_business_report)
  status ReportRunStatus

  // The real-world day this report covers (e.g. "yesterday" for the daily
  // report) — distinct from createdAt, which is when the run itself
  // happened and could differ slightly (a retried/regenerated run).
  reportDate DateTime

  data         Json? // null for skipped/failed runs — nothing was computed
  recipients   String[] // snapshot of who actually received it; empty for skipped/failed
  errorMessage String? // set only when status = failed

  createdAt DateTime @default(now())

  @@index([type, createdAt(sort: Desc)])
  @@map("report_runs")
}

// ---------------------------------------------------------------------------
// ReportSchedule — lets an admin turn each cadence of the Business Report
// on/off. The cadence's actual timing (daily 5 AM, weekly Monday 5 AM,
// monthly 1st 5 AM, quarterly 1st-of-quarter 5 AM) stays defined in code
// (server.js's cron.schedule calls) rather than becoming admin-editable —
// the spec fixes "5:00 AM Philippine Time" as a hard requirement for the
// daily report, not a configurable one, and giving every cadence an
// arbitrary custom time would mean building real dynamic cron
// (re)registration, a materially bigger and riskier change than an on/off
// toggle warrants today. One row per frequency, self-healing like
// HomepageSection below — a frequency with no row yet just means nobody
// has toggled it, and defaults to active.
// ---------------------------------------------------------------------------

enum ReportFrequency {
  daily
  weekly
  monthly
  quarterly
}

model ReportSchedule {
  id        String          @id @default(uuid())
  frequency ReportFrequency @unique
  active    Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("report_schedules")
}

// ---------------------------------------------------------------------------
// DashboardWidget — which summary cards an admin has pinned to
// /admin (the Dashboard Widgets section of the Reporting spec). Same
// self-healing, one-row-per-key pattern as HomepageSection: a key with no
// row yet just means nobody has changed its default (pinned) state.
// Platform-wide, not per-admin-user — the same reasoning as
// ReportRecipient's flat shape: real per-user dashboard preferences are a
// RBAC-adjacent feature explicitly deferred, not built partially here.
// ---------------------------------------------------------------------------

enum DashboardWidgetKey {
  todaysRevenue
  todaysOrders
  lowStock
  pendingShipments
  failedPayments
  mostViewedProducts
  mostTriedOnProducts
}

model DashboardWidget {
  id           String             @id @default(uuid())
  key          DashboardWidgetKey @unique
  active       Boolean            @default(true)
  displayOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dashboard_widgets")
}

// ---------------------------------------------------------------------------
// TryOnLog — Mongoose used a TTL index (expireAfterSeconds: 90 days) to
// auto-expire rows. Postgres has no equivalent; replaced by the same daily
// node-cron cleanup job that handles UserActivity below (see server.js).
// The @@index([createdAt]) below is what that job's DELETE query relies on.
// ---------------------------------------------------------------------------

model TryOnLog {
  id           String   @id @default(uuid())
  productId    String?
  product      Product? @relation(fields: [productId], references: [id])
  productName  String?
  productImage String?
  success      Boolean?

  // Added to answer a real question empirically (WaveSpeed model choice —
  // nano-banana-2 vs seedream vs nano-banana-pro) rather than trusting
  // provider documentation, which turned out to be incomplete/inconsistent
  // on latency. `provider` used to be a compound value like
  // "wavespeed:nano-banana-2" — split into bare `provider` ("wavespeed" /
  // "replicate") + `aiModel` ("nano-banana-2" / "seedream" / null for
  // Replicate) once the Fit Check gallery needed these as real, separately
  // filterable/reportable fields rather than one string a UI would have to
  // parse. `promptVersion` starts at "v1" — the WaveSpeed prompt was never
  // versioned before this; future prompt iterations bump it so old rows
  // keep recording which prompt actually produced them. `costUsd` is
  // computed from the real per-model prices already documented as comments
  // in wavespeedService.js, not invented.
  provider      String?
  aiModel       String?
  promptVersion String?
  costUsd       Float?
  durationMs    Int?

  // The AI result, durably re-hosted on Cloudinary (routes/tryon.js) —
  // neither provider's own image reference is meant to last: WaveSpeed's
  // is provider-hosted and time-limited, Replicate returns a raw base64
  // blob with nowhere persistent at all. A separate folder from the
  // temporary one the user's own uploaded photo still passes through and
  // gets deleted from (CLAUDE.md: Virtual Try-On inputs are deleted after
  // use, never retained — that rule is untouched by this field; this is
  // the AI's output, not the fan's uploaded photo).
  generatedImageUrl      String?
  generatedImagePublicId String?

  favorited Boolean @default(false)

  // Soft delete — a customer's "Delete" never removes the row. Nullable
  // timestamp, matching Notification.readAt's existing convention in this
  // schema rather than introducing a separate boolean-flag pattern.
  // Customer-facing reads always filter this out; only an explicit,
  // admin-gated `includeDeleted` query returns these rows (see
  // tryOnLogRepository.findByUser). Permanent removal — including the
  // Cloudinary asset — happens only via deleteOlderThan's existing 90-day
  // cron sweep, extended to destroy generatedImagePublicId first.
  deletedAt DateTime?

  // Added for the Customer Portal's per-user try-on history — every row
  // before this migration has userId: null with nothing to backfill from
  // (try-ons were never attributed to an account at all). onDelete: SetNull
  // so a deleted account doesn't erase aggregate try-on history/analytics.
  // sessionId mirrors UserActivity's guest-attribution convention.
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?

  // Phase 3 — set only when this generation bypassed the daily quota via an
  // active, unlimited FitCheckCampaign. onDelete: SetNull so a deleted
  // campaign never takes historical Fit Check rows down with it.
  fitCheckCampaignId String?
  fitCheckCampaign   FitCheckCampaign? @relation(fields: [fitCheckCampaignId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, favorited])
  @@map("try_on_logs")
}

// ---------------------------------------------------------------------------
// Wishlist — Customer Portal. Saved Commerce Items, i.e. purchase intent,
// not identity (that's Favorite/following an Organization — not built,
// no feature exists for it yet). Simple join, idempotent add via the
// unique constraint below rather than the route needing to check first.
// ---------------------------------------------------------------------------

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlists")
}

// ---------------------------------------------------------------------------
// Follow — My PUSO's Following. Backs docs/MY_PUSO_MANIFESTO.md's Following
// concept: a customer following an Organization (school/team/league/future
// athlete) is identity, not purchase intent — the same distinction
// CLAUDE.md's Terminology table already draws for Favorite. Mirrors
// Wishlist's shape exactly (same idempotent-upsert pattern in the
// repository) since both are simple customer↔entity join tables.
// ---------------------------------------------------------------------------

model Follow {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([userId])
  @@map("follows")
}

// ---------------------------------------------------------------------------
// Notification — Customer Portal inbox. Starts with a single producer
// (order status changes, see routes/orders.js) — `type` stays a single-value
// enum rather than a free string to match this codebase's existing
// discriminator convention (ActivityType, OrderEventType, etc.); new
// producers extend it the same way those were extended.
// ---------------------------------------------------------------------------

enum NotificationType {
  order
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// UserActivity — Mongoose used a TTL index (expireAfterSeconds: 90 days) to
// auto-expire rows. Postgres has no equivalent; replaced by a daily
// node-cron cleanup job (see server.js), following the same pattern already
// used there for the daily sales report. The @@index([timestamp]) below is
// what that job's DELETE query relies on.
// ---------------------------------------------------------------------------

model UserActivity {
  id        String       @id @default(uuid())
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  sessionId String?
  type      ActivityType
  productId String?
  product   Product?     @relation(fields: [productId], references: [id])
  query     String?
  category  String?
  sport     String?
  timestamp DateTime     @default(now())

  @@index([userId, type])
  @@index([sessionId, type])
  @@index([timestamp])
  @@map("user_activities")
}

// ---------------------------------------------------------------------------
// VenuePickupConfig
// ---------------------------------------------------------------------------

model VenuePickupConfig {
  id            String       @id @default(uuid())
  enabled       Boolean      @default(false)
  deadlineHours Int          @default(6)
  slots         PickupSlot[]

  // Mongoose set this manually in a pre('save') hook; Prisma's @updatedAt
  // does the same thing automatically — same behavior, less custom code.
  updatedAt DateTime @updatedAt

  @@map("venue_pickup_configs")
}

// Was VenuePickupConfig.slots[] (pickupSlotSchema, had its own _id — real
// table, same reasoning as Address and ProductColor).
model PickupSlot {
  id                  String            @id @default(uuid())
  configId            String
  config              VenuePickupConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  venueName           String?
  venueAddress        String?
  pickupDate          String? // "YYYY-MM-DD", stored as string to avoid timezone shifts — preserved as-is
  pickupHours         String?
  pickupStartTime     String? // "HH:MM" 24h PHT
  specialInstructions String?
  enabled             Boolean           @default(true)

  @@index([configId])
  @@map("pickup_slots")
}
